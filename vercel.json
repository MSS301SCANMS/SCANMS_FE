{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/live-health",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://heel-stamps-thing-formal.trycloudflare.com/api/:path*"
    },
    {
      "source": "/live-health",
      "destination": "https://heel-stamps-thing-formal.trycloudflare.com/live-health"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
