# Same-origin /api/v1 is proxied to Gateway during development.
VITE_API_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:8080
VITE_KEYCLOAK_ISSUER=http://localhost:8180/realms/scanms
# Configure a public OIDC client: Standard Flow enabled, PKCE S256.
VITE_KEYCLOAK_CLIENT_ID=scanms-frontend
# Add http://localhost:5173/auth/callback to Valid Redirect URIs.
# Add http://localhost:5173 to Web Origins.
# Add http://localhost:5173/login to Valid Post Logout Redirect URIs.
